{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knomo.local/schemas/catalog-v2/state-compaction-commit-v1.json",
  "title": "Knomo Catalog v2 state compaction commit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "sourceWriterId",
    "firstSequence",
    "lastSequence",
    "snapshot",
    "coveredSegments",
    "committingWriterId",
    "committedAt"
  ],
  "properties": {
    "kind": { "const": "knomo.catalog-v2.compaction-commit" },
    "schemaVersion": { "const": 1 },
    "sourceWriterId": { "$ref": "#/$defs/writerId" },
    "firstSequence": { "type": "integer", "minimum": 1 },
    "lastSequence": { "type": "integer", "minimum": 1 },
    "snapshot": { "$ref": "#/$defs/stateSnapshotRef" },
    "coveredSegments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stateSegmentRef" }
    },
    "committingWriterId": { "$ref": "#/$defs/writerId" },
    "committedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "writerId": { "type": "string", "pattern": "^w_[a-f0-9]{32}$" },
    "vaultPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^\\u0000-\\u001f]+$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byteLength"],
      "properties": {
        "path": { "$ref": "#/$defs/vaultPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1 }
      }
    },
    "stateSnapshotRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "path": {
              "pattern": "^(?:(?:[^/]+/)*_knomo-data/)?state/snapshots/w_[a-f0-9]{32}/snapshot-[A-Za-z0-9._-]+\\.json$"
            }
          }
        }
      ]
    },
    "stateSegmentRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "path": {
              "pattern": "^(?:(?:[^/]+/)*_knomo-data/)?state/devices/w_[a-f0-9]{32}/segment-[0-9]{6}\\.jsonl$"
            }
          }
        }
      ]
    }
  }
}
