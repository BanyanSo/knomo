{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knomo.local/schemas/catalog/shared-config-event-v1.json",
  "title": "Knomo Shared Configuration Event V1",
  "type": "object",
  "required": ["schemaVersion", "eventId", "writerId", "type", "baseEventIds", "occurredAt", "config"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "pattern": "^c_[a-f0-9]{32}$" },
    "writerId": { "type": "string", "pattern": "^w_[a-f0-9]{32}$" },
    "type": { "const": "set_config" },
    "baseEventIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^c_[a-f0-9]{32}$" }
    },
    "occurredAt": { "type": "string", "minLength": 1 },
    "config": {
      "type": "object",
      "required": ["schemaVersion", "daily", "monthly"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "daily": {
          "type": "object",
          "required": ["folder", "dateFormat", "headings"],
          "properties": {
            "folder": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "dateFormat": { "type": "string", "minLength": 1 },
            "headings": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^#{1,6}\\s+\\S" }
            }
          },
          "additionalProperties": false
        },
        "monthly": {
          "type": "object",
          "required": ["folder", "fileFormat", "dateHeadingFormat", "dateOrder", "rendererVersion"],
          "properties": {
            "folder": { "type": "string", "minLength": 1 },
            "fileFormat": { "type": "string", "minLength": 1 },
            "dateHeadingFormat": { "type": "string", "pattern": "^#{1,6}\\s+\\S" },
            "dateOrder": { "enum": ["asc", "desc"] },
            "rendererVersion": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
