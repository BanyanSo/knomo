{
	"name": "knomo",
	"version": "1.8.0",
	"description": "Capture local-first memos into daily notes and monthly archives.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check:i18n": "node scripts/check-i18n.mjs",
		"verify": "node scripts/verify.mjs",
		"benchmark:catalog:build": "tsc -p tsconfig.benchmark.json",
		"benchmark:catalog:generate": "npm run benchmark:catalog:build --silent && node .tmp/knomo-catalog-benchmark/scripts/catalog/generate-benchmark-vault.js",
		"benchmark:catalog:node": "npm run benchmark:catalog:build --silent && node .tmp/knomo-catalog-benchmark/scripts/catalog/run-node-benchmarks.js",
		"benchmark:catalog:summarize": "npm run benchmark:catalog:build --silent && node .tmp/knomo-catalog-benchmark/scripts/catalog/summarize-device-traces.js",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"test": "tsc -p tsconfig.test.json && node .tmp/knomo-tests/scripts/run-tests.js",
		"test:quiet": "tsc -p tsconfig.test.json && node .tmp/knomo-tests/scripts/run-tests.js --test-reporter=dot",
		"test:file": "tsc -p tsconfig.test.json && node .tmp/knomo-tests/scripts/run-tests.js --test-reporter=dot --files"
	},
	"keywords": [
		"memo",
		"notes",
		"local-first"
	],
	"author": "BanyanSo",
	"license": "MIT",
	"private": true,
	"devDependencies": {
		"@types/node": "^22.15.0",
		"@typescript-eslint/parser": "^8.61.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.4",
		"fake-indexeddb": "^6.2.5",
		"obsidian": "1.13.1",
		"typescript": "^5.8.0"
	},
	"dependencies": {
		"obsidian-daily-notes-interface": "^0.9.5"
	}
}
