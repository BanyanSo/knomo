{
	"name": "knomo",
	"version": "1.12.9",
	"description": "Capture local-first memos into daily notes and monthly archives.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check:i18n": "node scripts/check-i18n.mjs",
		"verify": "node scripts/verify.mjs",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"test": "tsc -p tsconfig.test.json && node .tmp/knomo-tests/scripts/run-tests.js",
		"test:quiet": "tsc -p tsconfig.test.json && node .tmp/knomo-tests/scripts/run-tests.js --test-reporter=dot",
		"test:tooling": "tsc -p tsconfig.test.json && node .tmp/knomo-tests/scripts/run-tests.js --suite=tooling",
		"test:all": "tsc -p tsconfig.test.json && node .tmp/knomo-tests/scripts/run-tests.js --suite=all",
		"test:file": "tsc -p tsconfig.test.json && node .tmp/knomo-tests/scripts/run-tests.js --test-reporter=dot --files"
	},
	"keywords": [
		"memo",
		"notes",
		"local-first"
	],
	"author": "BanyanSo",
	"license": "SEE LICENSE IN LICENSING.md",
	"private": true,
	"devDependencies": {
		"@codemirror/commands": "6.8.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@lezer/common": "1.5.2",
		"@lezer/markdown": "1.4.3",
		"@types/jsdom": "21.1.7",
		"@types/node": "^22.15.0",
		"@typescript-eslint/parser": "^8.61.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.4",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "26.1.0",
		"obsidian": "https://codeload.github.com/obsidianmd/obsidian-api/tar.gz/9abd9605ce081383674aae1ed111c456edde0688",
		"typescript": "^5.8.0"
	}
}
