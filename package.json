{
	"name": "knomo",
	"version": "1.2.1",
	"description": "Capture local-first memos into daily notes and monthly archives.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check:i18n": "node scripts/check-i18n.mjs",
		"verify": "node scripts/verify.mjs",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"test": "tsc -p tsconfig.test.json && node .tmp/knomo-tests/scripts/run-tests.js"
	},
	"keywords": [
		"memo",
		"notes",
		"local-first"
	],
	"author": "BanyanSo",
	"license": "MIT",
	"private": true,
	"devDependencies": {
		"@types/node": "^22.15.0",
		"@typescript-eslint/parser": "^8.61.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.4",
		"obsidian": "1.11.0",
		"typescript": "^5.8.0"
	},
	"dependencies": {
		"obsidian-daily-notes-interface": "^0.9.5"
	}
}
