{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "CommonJS",
		"rootDir": ".",
		"outDir": ".tmp/knomo-tests",
		"incremental": true,
		"tsBuildInfoFile": ".tmp/knomo-tests/tsconfig.tsbuildinfo",
		"inlineSourceMap": false,
		"sourceMap": true,
		"types": ["node"]
	},
	"include": [
		"src/**/*.ts",
		"scripts/run-tests.ts",
		"tests/**/*.ts"
	]
}
